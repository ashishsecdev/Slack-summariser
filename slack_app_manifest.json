{
    "display_information": {
        "name": "Slack_Ollama"
    },
    "features": {
        "bot_user": {
            "display_name": "<APP_NAME>",
            "always_online": false
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "chat:write",
                "im:history",
                "im:write",
                "users:read",
                "app_mentions:read",
                "channels:history",
                "channels:read",
                "groups:history"
            ]
        }
    },
    "settings": {
        "event_subscriptions": {
            "request_url": "https://<_ENDPOINT_OF_YOUR_FLASK_APP_>/slack/events",
            "bot_events": [
                "app_mention",
                "message.channels",
                "message.im"
            ]
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "token_rotation_enabled": false
    }
}
